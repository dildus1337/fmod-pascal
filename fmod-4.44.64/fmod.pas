implementation

procedure FMOD_64BIT_ADD(var hi1, lo1: Cardinal; hi2, lo2: Cardinal);
begin
  hi1 := hi1 + hi2 + Cardinal(Ord((lo1 + lo2) < lo1));
  lo1 := lo1 + lo2;
end;

procedure FMOD_64BIT_SUB(var hi1, lo1: Cardinal; hi2, lo2: Cardinal);
begin
  hi1 := hi1 - (hi2 + Cardinal(Ord((lo1 - lo2) > lo1)));
  lo1 := lo1 - lo2;
end;


